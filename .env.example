# Google Gemini API Key
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY can also be used as an alias:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Document & Storage Paths
PDF_PATH=data/History_2024-25.pdf
CHROMA_PERSIST_DIRECTORY=chroma_db

# Model Configurations
# Supported Gemini models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Supported embedding models: models/gemini-embedding-001 (active stable), gemini-embedding-001
EMBEDDING_MODEL=models/gemini-embedding-001

# Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
